# Base URL of the station's FastAPI server, exposed to the internet via a
# Cloudflare Tunnel (see station/TUNNEL.md). The browser calls this directly
# for printer status + camera snapshots, and /api/upload calls it after each
# submission to tell the laptop to come download the blob (webhook-driven, no
# polling).
STATION_API_URL=https://makerlab-status.YOUR_TUNNEL.cfargotunnel.com

# Shared secret sent in the x-station-key header when notifying the laptop's
# /api/blob-webhook endpoint. Must match web.webhook_secret in the laptop's
# config.json. Generate with: openssl rand -hex 32
STATION_WEBHOOK_SECRET=replace_with_long_random_secret

# Vercel Blob read/write token (create a Blob store in the Vercel dashboard).
# Used by /api/upload to store student submissions under "incoming/".
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# ---------------------------------------------------------------------------
# EMAIL LABELING — FUTURE FEATURE, DISABLED. Leave all of this unset until the
# lab has a Cornell sender address AND the upload form records consent.
# With EMAIL_LABELING_ENABLED unset (or anything but "true"), /api/notify-print-end
# answers 501 and email-link labels are refused.
# ---------------------------------------------------------------------------
EMAIL_LABELING_ENABLED=false

# HMAC secret that signs the links in label emails (>= 16 chars). Generate with:
#   openssl rand -hex 32
LABEL_LINK_SECRET=replace_with_long_random_secret

# Resend (https://resend.com) API key and the verified sender address.
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=MakerLAB <makerlab@YOUR-VERIFIED-DOMAIN>

# Domain appended to a NetID to form the recipient (ab123@cornell.edu).
EMAIL_DOMAIN=cornell.edu

# Public base URL used in email links (defaults to the request's own origin).
PUBLIC_SITE_URL=https://bambu-farm-web.vercel.app
